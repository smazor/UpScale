# Local Claude Code settings (contain machine-specific paths)
.claude/

# Source artwork and generated print files are large / private: keep the folders
# (via .gitkeep) but not their contents. Back these up separately.
in-image/*
!in-image/.gitkeep
out-image/*
!out-image/.gitkeep
